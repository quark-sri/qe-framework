{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqef.dev/schemas/test-result.schema.json",
  "title": "AQEF normalized test result",
  "description": "One record per test execution. The Results Normalizer converts JUnit XML, Allure, Playwright, pytest, k6, ZAP and axe output to this format.",
  "type": "object",
  "required": ["run_id", "env", "build", "test_id", "title", "level", "capability", "requirements", "risk", "status", "duration_ms"],
  "properties": {
    "run_id": {"type": "string"},
    "env": {"type": "string", "examples": ["dev-container", "test", "staging", "prod"]},
    "build": {"type": "string"},
    "commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "test_id": {"type": "string", "description": "Stable ID: file path plus test name, or scenario ID"},
    "title": {"type": "string"},
    "level": {"enum": ["unit", "component", "contract", "integration", "api", "ui", "nfr"]},
    "nfr": {"enum": ["security", "perf", "a11y", null]},
    "capability": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
    "requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risk": {"enum": ["t1", "t2", "t3"]},
    "suite": {"type": "array", "items": {"type": "string"}},
    "defects": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "quarantined": {"type": "boolean", "default": false},
    "status": {"enum": ["passed", "failed", "skipped", "broken"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "retry_index": {"type": "integer", "minimum": 0, "default": 0},
    "error_message": {"type": ["string", "null"]},
    "error_signature": {"type": ["string", "null"], "description": "Normalized error: exception type plus top app frame, numbers and IDs removed"},
    "failing_step": {"type": ["string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object", "properties": {"type": {"enum": ["log", "screenshot", "trace", "video", "har", "report"]}, "path": {"type": "string"}}, "required": ["type", "path"]}},
    "triage_state": {"enum": ["product_defect_new", "known_defect", "regression_of_fixed_defect", "test_defect", "expected_change", "test_data_issue", "environment", "flaky", "needs_investigation", null]},
    "first_failed_run": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
